# vim:ft=conf
#
# Ghostty translation of config/kitty/kitty.conf. Keep the two in sync: every
# setting below maps 1:1 to a kitty setting, and deliberate gaps are marked
# with "no ghostty equivalent".

theme = catppuccin-macchiato-custom

# kitty: shell_integration no-title
shell-integration-features = cursor,no-sudo,no-title,no-ssh-env,no-ssh-terminfo

# kitty: macos_option_as_alt yes
macos-option-as-alt = true

# kitty: hide_window_decorations titlebar-only
macos-titlebar-style = hidden

# no ghostty equivalent: `editor vim` (ghostty uses $EDITOR / $VISUAL)
# no ghostty equivalent: cursor_trail / cursor_trail_decay /
#   cursor_trail_start_threshold

# Machine-specific overrides generated by nix (programs/ghostty.nix)
config-file = machine

font-family           = Iosevka Term
font-style            = Light
font-style-bold       = Extrabold
font-style-italic     = Light Italic
font-style-bold-italic = Bold Italic

# No symbol map (kitty: symbol_map). Kitty's `include font-nerd-symbols.conf`
# never resolves -- the deployed file is font-nerd-symbol.conf, singular -- so
# kitty renders nerd glyphs through automatic font fallback, and ghostty does
# the same here. Box drawing in particular must stay unmapped: both terminals
# draw that range themselves, scaled to the full cell, so lines connect across
# rows even with adjust-cell-height set. Forcing it to a font renders vertical
# rules dashed.

# kitty: modify_font. Ghostty's adjust-* values are deltas from the computed
# metric, so kitty's "100%" (unchanged) and "0" entries are simply omitted and
# kitty's 150% underline thickness becomes a +50% adjustment.
adjust-cell-height            = 4
adjust-underline-position     = 5
adjust-underline-thickness    = 50%
adjust-strikethrough-position = 2

# kitty: dynamic_background_opacity yes / background_opacity / background_blur
background-opacity = 0.95
background-blur    = 12

# Tab bar: ghostty uses native macOS tabs, so kitty's tab_bar_style,
# tab_powerline_style, tab_bar_margin_*, tab_separator and the
# tab_title_template / active_tab_title_template powerline templates have no
# equivalent. Titlebar colors live in the theme file.
window-show-tab-bar = auto

# kitty: window_padding_width 24 32  (vertical, horizontal)
window-padding-y = 24
window-padding-x = 32

# kitty: map shift+cmd+e select_tab. Ghostty has no tab picker on macOS;
# the command palette is the closest thing and is already on super+shift+p.
# keybind = super+shift+e=toggle_tab_overview   # GTK only, no-op on macOS
