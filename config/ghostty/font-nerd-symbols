# vim:ft=conf
#
# - Use additional nerd symbols
# Translated from config/kitty/font-nerd-symbol.conf (kitty `symbol_map`).
# See https://github.com/be5invis/Iosevka/issues/248
# See https://github.com/ryanoasis/nerd-fonts/wiki/Glyph-Sets-and-Code-Points

# Seti-UI + Custom
font-codepoint-map = U+E5FA-U+E6AC=CaskaydiaCove Nerd Font

# Devicons
font-codepoint-map = U+E700-U+E7C5=CaskaydiaCove Nerd Font

# Font Awesome
font-codepoint-map = U+F000-U+F2E0=CaskaydiaCove Nerd Font

# Font Awesome Extension
font-codepoint-map = U+E200-U+E2A9=CaskaydiaCove Nerd Font

# Material Design Icons
font-codepoint-map = U+F0001-U+F1AF0=CaskaydiaCove Nerd Font

# Weather
font-codepoint-map = U+E300-U+E3E3=CaskaydiaCove Nerd Font

# Octicons
font-codepoint-map = U+F400-U+F532,U+2665,U+26A1=CaskaydiaCove Nerd Font

# Powerline Symbols
font-codepoint-map = U+E0A0-U+E0A2,U+E0B0-U+E0B3=CaskaydiaCove Nerd Font

# Powerline Extra Symbols
font-codepoint-map = U+E0A3,U+E0B4-U+E0C8,U+E0CA,U+E0CC-U+E0D4=CaskaydiaCove Nerd Font

# IEC Power Symbols
font-codepoint-map = U+23FB-U+23FE,U+2B58=CaskaydiaCove Nerd Font

# Font Logos
font-codepoint-map = U+F300-U+F32F=CaskaydiaCove Nerd Font

# Pomicons
font-codepoint-map = U+E000-U+E00A=CaskaydiaCove Nerd Font

# Codicons
font-codepoint-map = U+EA60-U+EBEB=CaskaydiaCove Nerd Font

# Additional sets
# Heavy Angle Brackets
font-codepoint-map = U+E276C-U+E2771=CaskaydiaCove Nerd Font
# Box Drawing
font-codepoint-map = U+2500-U+259F=CaskaydiaCove Nerd Font
# Stars
font-codepoint-map = U+2724-U+2728=CaskaydiaCove Nerd Font

# Some symbols not covered by CaskaydiaCove Nerd Font
# nonicons contains icons in the range: U+F101-U+F27D
# U+F167 is HTML logo, but YouTube logo in CaskaydiaCove Nerd Font
font-codepoint-map = U+F102,U+F116-U+F118,U+F12F,U+F13E,U+F1AF,U+F1BF,U+F1CF,U+F1FF,U+F20F,U+F21F-U+F220,U+F22E-U+F22F,U+F23F,U+F24F,U+F25F=nonicons
