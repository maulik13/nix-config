## Translated from config/kitty/themes/rosepine-moon-custom.conf

foreground           = #e0def4
background           = #232136
selection-foreground = #e0def4
selection-background = #44415a

cursor-color = #56526e
cursor-text  = #e0def4

# Titlebar, standing in for kitty's tab bar colors.
window-titlebar-background = #232136
window-titlebar-foreground = #6e6a86

# Kitty's active_border_color / inactive_border_color have no split equivalent
# beyond the divider.
split-divider-color = #44415a

# black
palette = 0=#393552
palette = 8=#6e6a86

# red
palette = 1=#eb6f92
palette = 9=#eb6f92

# green
palette = 2=#32BBBB
palette = 10=#32BBBB

# yellow
palette = 3=#f6c177
palette = 11=#f6c177

# blue
palette = 4=#9ccfd8
palette = 12=#9ccfd8

# magenta
palette = 5=#c4a7e7
palette = 13=#c4a7e7

# cyan
palette = 6=#ea9a97
palette = 14=#ea9a97

# white
palette = 7=#e0def4
palette = 15=#e0def4
